# Local development settings for all three roles. Copy to `.env` (git-ignored).
# Every value below matches deploy/docker-compose.dev.yml. These are well-known
# local-only credentials, not secrets; real environments read secrets from the
# secrets store (OD-5) and never from a committed file.
#
# Variables use the prefix BUSMORA_AI_ and "__" for nesting. Each role reads only
# the stores it is allowed to use; extra variables are ignored.

BUSMORA_AI_ENVIRONMENT=local
BUSMORA_AI_LOG_LEVEL=INFO
BUSMORA_AI_LOG_FORMAT=console

# Postgres: read-only brain_read views + the ai_runtime schema (ai-http, ai-agent)
BUSMORA_AI_POSTGRES__DSN=postgresql://busmora_ai:busmora_ai_dev@127.0.0.1:5432/busmora

# Qdrant (ai-http, ai-agent)
BUSMORA_AI_QDRANT__URL=http://127.0.0.1:6333

# Redis: Canvas streams and crawl cache (ai-agent, ai-crawl)
BUSMORA_AI_REDIS__URL=redis://127.0.0.1:6379/0

# S3-compatible object storage, RustFS locally (ai-agent, ai-crawl)
BUSMORA_AI_OBJECT_STORAGE__ENDPOINT_URL=http://127.0.0.1:9000
BUSMORA_AI_OBJECT_STORAGE__BUCKET=busmora-dev
BUSMORA_AI_OBJECT_STORAGE__ACCESS_KEY_ID=busmora_dev
BUSMORA_AI_OBJECT_STORAGE__SECRET_ACCESS_KEY=busmora_dev_secret

# Temporal dev server (ai-agent, ai-crawl)
BUSMORA_AI_TEMPORAL__ADDRESS=127.0.0.1:7233
BUSMORA_AI_TEMPORAL__NAMESPACE=default
